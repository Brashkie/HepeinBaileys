{
  "name": "hepeinbaileys",
  "version": "1.0.0",
  "description": "Fork profesional de Baileys para WhatsApp Web y Business con IA, plugins, grandes volúmenes y arquitectura empresarial",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rimraf dist",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "docs": "typedoc --out docs src/index.ts",
    "benchmark": "node --require tsx/register benchmarks/index.ts",
    "pre-push": "bash scripts/pre-push.sh"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-business",
    "baileys",
    "bot",
    "chatbot",
    "wa-bot",
    "whatsapp-api",
    "typescript",
    "javascript",
    "ai",
    "nlp",
    "big-data",
    "enterprise",
    "scalable"
  ],
  "author": {
    "name": "Brashkie",
    "url": "https://github.com/Brashkie"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brashkie/HepeinBaileys.git"
  },
  "bugs": {
    "url": "https://github.com/Brashkie/HepeinBaileys/issues"
  },
  "homepage": "https://github.com/Brashkie/HepeinBaileys#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.5",
    "lru-cache": "^11.0.2",
    "bull": "^4.16.3",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "nanoid": "^5.0.7",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.3",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typedoc": "^0.26.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": "^6.7.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.4"
  }
}
